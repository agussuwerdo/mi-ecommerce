APP_NAME=Ci3
APP_ENV=development
APP_URL=http://localhost
CI_ENV=development

# Neon / Vercel: use the DIRECT endpoint (no -pooler in the hostname).
# Takes precedence over the legacy MySQL settings below.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require&connect_timeout=15

#log level (application.config.config)
LOG_THRESHOLD=0

#database connection (application.config.database)
DB_CONNECTION=mysqli
DB_HOST=mi_ecommerce_mysql
DB_PORT=3306
DB_DATABASE=midb
DB_USERNAME=mi
DB_PASSWORD=miecommerce
DB_DEBUG=true
